# ───────────────────────── 服务 ─────────────────────────
PORT=8080
API_KEY=                      # 自用 API（X-API-Key），M6 起强制
ADMIN_TOKEN=                  # Admin 鉴权，M6 起强制
SESSION_DATA_DIR=./data       # SQLite + 会话缓存目录（挂 volume）

# ─────────────────── SWPU 账号（基座，M2 起用） ───────────────────
# 多账号用编号后缀，email_account.creds_ref 指向这些键的前缀（如 SWPU_ACCT_1）
SWPU_ACCT_1_NAME=
SWPU_ACCT_1_PASS=
SWPU_ACCT_1_IMAP_PASS=        # IMAP 独立密码（非登录密码）
SWPU_ACCT_1_GROUP=swpu
SWPU_CAPTCHA_API_TOKEN=       # 登录打码

# ───────────────────────── IMAP ─────────────────────────
IMAP_HOST=mailgate.swpu.edu.cn
IMAP_PORT=993

# ─────────────── CloakBrowser（容器内固定，仅登录用） ───────────────
CLOAKBROWSER_BINARY_PATH=
CLOAKBROWSER_AUTO_UPDATE=false

# ─────────────── 调度默认（可被单个 plan 覆盖） ───────────────
LEASE_TTL_SEC=900             # 租约「无码」上限：15min
ACQUIRE_TIMEOUT_SEC=60        # 池满排队等待上限，超时 POOL_BUSY
RETENTION_SEC=604800          # 成功收码后保留期：7 天

# ─────────────── 接入层 API（M6） ───────────────
RATE_LIMIT_ACTIVATE_MAX=10    # activate 限流：单 code+IP 在窗口内最多次数
RATE_LIMIT_WINDOW_SEC=60      # activate 限流窗口（秒）
WEBHOOK_SECRET=               # 自用 API webhook HMAC 签名密钥（空=不签名）
WEBHOOK_TIMEOUT_MS=8000       # webhook 单次回调超时
WEBHOOK_MAX_RETRIES=3         # webhook 失败重试次数

# ─────────────── 运维定时任务（M8） ───────────────
CLEANUP_INTERVAL_SEC=21600    # 删信周期：6 小时（FR-9）
CLEANUP_BEFORE_DAYS=3         # 删除多少天前的邮件
GC_INTERVAL_SEC=3600          # 回看期满 GC 周期：1 小时（FR-10）
